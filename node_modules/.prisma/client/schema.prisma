// ══════════════════════════════════════════════════
// GRIOTTE — Schéma Prisma
// Base de données PostgreSQL
// ══════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ══════════════════════════════════════════════════
// ENUMS
// ══════════════════════════════════════════════════

enum Role {
  READER
  AUTHOR
  ADMIN
}

enum BookStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
  ARCHIVED
}

enum TransactionType {
  RECHARGE // lecteur recharge son portefeuille
  PAGE_READ // débit lors d'une lecture
  AUTHOR_CREDIT // crédit auteur (60%)
  PLATFORM_FEE // commission GRIOTTE (40%)
  WITHDRAWAL // retrait auteur
  REFERRAL_BONUS // bonus parrainage
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum WithdrawalStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum PaymentMethod {
  MOBILE_MONEY
  BANK_TRANSFER
  CARD
}

// ══════════════════════════════════════════════════
// USER
// ══════════════════════════════════════════════════

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String?
  googleId      String?   @unique
  name          String
  avatar        String?
  verified      Boolean   @default(false)
  country       String?
  role          Role      @default(READER)
  isVerified    Boolean   @default(false)
  isSuspended   Boolean   @default(false)
  suspendedAt   DateTime?
  suspendReason String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastLoginAt   DateTime?

  // Relations
  wallet           Wallet?
  books            Book[]
  readingSessions  ReadingSession[]
  transactions     Transaction[]
  bookmarks        Bookmark[]
  reviews          Review[]
  notifications    Notification[]
  referralsSent    Referral[]       @relation("referrer")
  referralReceived Referral?        @relation("referred")
  refreshTokens    RefreshToken[]
  withdrawals      Withdrawal[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("refresh_tokens")
}

// ══════════════════════════════════════════════════
// WALLET
// ══════════════════════════════════════════════════

model Wallet {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance   Int      @default(0) // en FCFA (centimes entiers)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("wallets")
}

// ══════════════════════════════════════════════════
// BOOK
// ══════════════════════════════════════════════════

model Book {
  id               String     @id @default(cuid())
  authorId         String
  author           User       @relation(fields: [authorId], references: [id])
  title            String
  subtitle         String?
  synopsis         String
  coverColor       String     @default("cs1")
  coverImage       String? // URL Cloudflare R2
  genre            String
  subGenre         String?
  country          String?
  language         String     @default("fr")
  tags             String[]
  targetAudience   String     @default("ALL")
  sensitiveContent String     @default("NONE")
  totalPages       Int        @default(0)
  authorNote       String?
  status           BookStatus @default(DRAFT)
  publishedAt      DateTime?
  scheduledAt      DateTime?
  rejectionNote    String?
  isPublic         Boolean    @default(true)
  isFreeFirst      Boolean    @default(true) // ch.1 gratuit
  yearWritten      Int?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  // Relations
  chapters        Chapter[]
  readingSessions ReadingSession[]
  bookmarks       Bookmark[]
  reviews         Review[]

  // Stats dénormalisées (mis à jour par trigger)
  totalReads    Int   @default(0)
  totalRevenue  Int   @default(0) // FCFA
  averageRating Float @default(0)
  reviewCount   Int   @default(0)

  @@map("books")
}

// ══════════════════════════════════════════════════
// CHAPTER
// ══════════════════════════════════════════════════

model Chapter {
  id          String   @id @default(cuid())
  bookId      String
  book        Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  number      Int
  title       String
  content     String? // texte brut extrait du fichier
  fileUrl     String? // URL fichier original R2
  pageCount   Int      @default(0)
  wordCount   Int      @default(0)
  isFree      Boolean  @default(false)
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  readingSessions ReadingSession[]

  @@unique([bookId, number])
  @@map("chapters")
}

// ══════════════════════════════════════════════════
// READING SESSION
// ══════════════════════════════════════════════════

model ReadingSession {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  bookId    String
  book      Book     @relation(fields: [bookId], references: [id])
  chapterId String?
  chapter   Chapter? @relation(fields: [chapterId], references: [id])

  startPage      Int @default(1)
  endPage        Int @default(1)
  pagesRead      Int @default(0)
  amountDebit    Int @default(0) // FCFA débité au lecteur
  amountAuthor   Int @default(0) // FCFA crédité auteur (60%)
  amountPlatform Int @default(0) // FCFA plateforme (40%)

  startedAt DateTime  @default(now())
  endedAt   DateTime?
  duration  Int? // secondes

  createdAt DateTime @default(now())

  transaction Transaction?

  @@map("reading_sessions")
}

// ══════════════════════════════════════════════════
// TRANSACTION
// ══════════════════════════════════════════════════

model Transaction {
  id               String            @id @default(cuid())
  userId           String
  user             User              @relation(fields: [userId], references: [id])
  type             TransactionType
  status           TransactionStatus @default(PENDING)
  amount           Int // FCFA
  balanceBefore    Int
  balanceAfter     Int
  description      String?
  reference        String?           @unique // ID externe (FedaPay, etc.)
  paymentMethod    PaymentMethod?
  readingSessionId String?           @unique
  readingSession   ReadingSession?   @relation(fields: [readingSessionId], references: [id])
  metadata         Json?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@map("transactions")
}

// ══════════════════════════════════════════════════
// WITHDRAWAL
// ══════════════════════════════════════════════════

model Withdrawal {
  id            String           @id @default(cuid())
  userId        String
  user          User             @relation(fields: [userId], references: [id])
  amount        Int // FCFA
  method        PaymentMethod
  accountNumber String // numéro Mobile Money ou IBAN
  accountName   String
  status        WithdrawalStatus @default(PENDING)
  processedAt   DateTime?
  adminNote     String?
  reference     String? // référence transfert
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@map("withdrawals")
}

// ══════════════════════════════════════════════════
// BOOKMARK
// ══════════════════════════════════════════════════

model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookId    String
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  page      Int      @default(1)
  note      String?
  createdAt DateTime @default(now())

  @@unique([userId, bookId])
  @@map("bookmarks")
}

// ══════════════════════════════════════════════════
// REVIEW
// ══════════════════════════════════════════════════

model Review {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookId    String
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  rating    Int // 1–5
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, bookId])
  @@map("reviews")
}

// ══════════════════════════════════════════════════
// NOTIFICATION
// ══════════════════════════════════════════════════

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  type      String // PAGE_READ, WITHDRAWAL, NEW_REVIEW, etc.
  isRead    Boolean  @default(false)
  data      Json?
  createdAt DateTime @default(now())

  @@map("notifications")
}

// ══════════════════════════════════════════════════
// REFERRAL
// ══════════════════════════════════════════════════

model Referral {
  id          String   @id @default(cuid())
  referrerId  String
  referrer    User     @relation("referrer", fields: [referrerId], references: [id])
  referredId  String   @unique
  referred    User     @relation("referred", fields: [referredId], references: [id])
  bonusAmount Int      @default(200) // 200 FCFA
  bonusPaid   Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@map("referrals")
}

model Otp {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  code      String
  expires   DateTime
  createdAt DateTime @default(now())
}
