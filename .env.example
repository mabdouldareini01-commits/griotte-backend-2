# ══════════════════════════════════════════════════
# GRIOTTE BACKEND — Variables d'environnement
# Copiez ce fichier en .env et remplissez les valeurs
# ══════════════════════════════════════════════════

# ─── Application
NODE_ENV=development
PORT=4000
API_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000

# ─── Base de données PostgreSQL
DATABASE_URL="postgresql://griotte:password@localhost:5432/griotte_db?schema=public"

# ─── JWT
JWT_SECRET=votre_secret_jwt_tres_long_et_securise_minimum_64_caracteres
JWT_REFRESH_SECRET=votre_secret_refresh_different_du_jwt_secret

# ─── Google OAuth2
GOOGLE_CLIENT_ID=votre_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=votre_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback

# ─── Cloudflare R2 (stockage fichiers)
R2_ACCOUNT_ID=votre_cloudflare_account_id
R2_ACCESS_KEY_ID=votre_r2_access_key
R2_SECRET_ACCESS_KEY=votre_r2_secret_key
R2_BUCKET_NAME=griotte-files
R2_PUBLIC_URL=https://files.griotte.africa

# ─── FedaPay (paiements Mobile Money Afrique de l'Ouest)
FEDAPAY_API_KEY=votre_fedapay_api_key
FEDAPAY_SITE_ID=votre_fedapay_site_id

# ─── Flutterwave (paiements alternatif)
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-xxxx
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-xxxx

# ─── Email (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@griotte.africa
SMTP_PASS=votre_mot_de_passe_app

# ─── Redis (cache & sessions — optionnel)
REDIS_URL=redis://localhost:6379
